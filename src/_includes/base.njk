<!doctype html>
<html lang="en" class="{{ theme | default("theme-kelp-light") }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>html,body{background:#3f6250}</style>
  <title>{{ title | default("wobpager") }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ "/css/main.css" | url }}">
  <script type="importmap">
    { "imports": { "three": "{{ "/js/vendor/three.module.js" | url }}" } }
  </script>
</head>
<body class="{{ bodyClass | default("") }}" data-kelp-demo>
  {% if not backgroundOnly %}
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="{{ "/" | url }}">wobpager</a>
      <a href="{{ "/about/" | url }}">About</a>
      <a href="{{ "/themes/" | url }}">Themes</a>
      <a href="{{ "/glass/" | url }}">Glass</a>
      {% include "palette-switcher.njk" %}
    </nav>
  {% endif %}
  <main class="site-main">
    {{ content | safe }}
  </main>
  <script type="module" src="{{ "/js/kelp-background.js" | url }}"></script>
  <script type="module" src="{{ "/js/theme-switcher.js" | url }}"></script>
</body>
</html>

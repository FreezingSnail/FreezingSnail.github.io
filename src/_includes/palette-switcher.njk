<details class="palette-switcher theme-menu" data-palette-switcher>
  <summary class="theme-menu-summary" aria-label="Choose a sea palette">
    <span class="theme-menu-kicker">Palette</span>
    <span data-theme-label>Kelp light</span>
  </summary>
  <div class="palette-switcher-actions" role="group" aria-label="Choose a sea palette">
    <button class="mode-button" type="button" data-theme="theme-kelp-light" aria-pressed="true">Kelp light</button>
    <button class="mode-button" type="button" data-theme="theme-kelp-dark" aria-pressed="false">Kelp dark</button>
    <button class="mode-button" type="button" data-theme="theme-tidepool" aria-pressed="false">Tidepool</button>
    <button class="mode-button" type="button" data-theme="theme-sunlit" aria-pressed="false">Sunlit reef</button>
    <button class="mode-button" type="button" data-theme="theme-nightwatch" aria-pressed="false">Nightwatch</button>
  </div>
</details>

---
layout: base.njk
theme: theme-kelp-light
title: Kelp glass · wobpager
description: Low-poly kelp forest studies across sea-light palettes.
---

<section class="kelp-demo" data-kelp-demo>
  <header class="demo-hero">
    <p class="eyebrow">/ Live theme studies</p>
    <h1>Kelp worlds<br>under glass.</h1>
    <p class="hero-copy">One shared underwater scene renderer, evaluated through light, dark, and regional sea palettes beneath readable frosted surfaces.</p>
    <div class="demo-switch">
      <button class="mode-button" type="button" data-blur-toggle aria-pressed="false">Sharpen background</button>
    </div>
    <label class="scene-picker">Forest study
      <select data-demo-scene-select aria-label="Choose underwater scene study">
        <option value="thicket">Ribbon thicket</option><option value="grove">Giant kelp grove</option><option value="canopy">Canopy passage</option><option value="clearing">Forest clearing</option>
        <option value="wall">Kelp wall</option><option value="aisle">Stipe aisle</option><option value="tangle">Ribbon tangle</option><option value="deep">Deep grove</option>
        <option value="bulb-bed">Bulb kelp bed</option><option value="feather-meadow">Feather meadow</option><option value="fan-reef">Fan reef</option><option value="mosaic">Species mosaic</option>
        <option value="tower-grove">Tower grove</option><option value="palm-canopy">Palm canopy</option><option value="giant-wall">Giant wall</option><option value="open-forest">Open forest</option>
      </select>
    </label>
  </header>

  <article class="demo-pane">
    <p class="meta-label">/ Scene parameters</p>
    <dl class="scene-spec">
      <div><dt>Canopy</dt><dd>Shared renderer · exact Scene studies geometry</dd></div>
      <div><dt>Forest</dt><dd data-demo-scene-name>Random Scene study · rotates every 18s</dd></div>
      <div><dt>Current</dt><dd>Slow boid crossings · layered foreground occlusion</dd></div>
      <div><dt>Focus</dt><dd>Background-only blur · panes remain frosted</dd></div>
    </dl>
  </article>
</section>

<script>
  (() => {
    const root = document.querySelector("[data-kelp-demo]");
    if (!root) return;

    const blurToggle = root.querySelector("[data-blur-toggle]");
    blurToggle?.addEventListener("click", () => {
      const sharpened = document.documentElement.classList.toggle("scene-inspection");
      blurToggle.setAttribute("aria-pressed", String(sharpened));
      blurToggle.textContent = sharpened ? "Blur background" : "Sharpen background";
    });
  })();
</script>
